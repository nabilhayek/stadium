    "@vercel/functions": "^3.10.5",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.151",
    "better-auth": "^1.7.5",
    "clsx": "^2.1.1",
    "flag-icons": "^7.6.0",
    "framer-motion": "^13.4.0",
