// Stadium food delivery — data model foundation.
// Connection URL lives in prisma.config.ts (Prisma 7).

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

/// A venue. Reached via example.com/[slug].
model Stadium {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  city      String?
  /// ISO 4217 code, e.g. "EUR". Prices are stored in minor units (cents).
  currency  String   @default("EUR")
  timezone  String   @default("Europe/Amsterdam")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendors  Vendor[]
  sections Section[]
  orders   Order[]
  receipts Receipt[]

  @@index([isActive])
}

/// Customer-facing order document. Local-first: the phone writes it to its own
/// storage first, then syncs it here so `/[stadium]/order/[orderNumber]` resolves
/// on a fresh device. `body` is the receipt exactly as the client stores it;
/// the columns beside it exist for lookups only.
model Receipt {
  id          String   @id @default(cuid())
  stadiumId   String
  /// Short code shown to the customer, e.g. "A-K7M2". Unique per stadium.
  orderNumber String
  /// Anonymous per-install id so a phone can restore its own history.
  deviceId    String
  /// Client-generated write secret. Updates must present it; reads never return it.
  token       String
  paidAt      DateTime
  readyAt     DateTime
  totalCents  Int
  currency    String
  body        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stadium Stadium @relation(fields: [stadiumId], references: [id], onDelete: Cascade)

  @@unique([stadiumId, orderNumber])
  @@index([stadiumId, deviceId, paidAt])
}

/// A seating block / stand. Used for "confirm seat" and delivery routing.
model Section {
  id        String   @id @default(cuid())
  stadiumId String
  code      String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stadium Stadium @relation(fields: [stadiumId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@unique([stadiumId, code])
  @@index([stadiumId, sortOrder])
}

/// A food/drink outlet inside a stadium.
model Vendor {
  id          String   @id @default(cuid())
  stadiumId   String
  slug        String
  name        String
  description String?
  imageUrl    String?
  isOpen      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stadium  Stadium   @relation(fields: [stadiumId], references: [id], onDelete: Cascade)
  products Product[]
  orders   Order[]

  @@unique([stadiumId, slug])
  @@index([stadiumId, isOpen, sortOrder])
}

/// Global product category (Drinks, Snacks, Hot food...). Shared across stadiums.
model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  /// Optional category mark. The shop UI no longer displays emoji.
  icon      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([sortOrder])
}

model Product {
  id          String   @id @default(cuid())
  vendorId    String
  categoryId  String
  name        String
  description String?
  imageUrl    String?
  /// Minor units (cents). Never store floats for money.
  priceCents  Int
  isAvailable Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor     Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category   Category    @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@index([vendorId, isAvailable, sortOrder])
  @@index([categoryId])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

/// One order = one vendor (keeps prep + delivery simple). Multi-vendor carts split into several orders.
model Order {
  id         String      @id @default(cuid())
  /// Short human-readable code shown to runners and customers, e.g. "A7K2".
  code       String      @unique
  stadiumId  String
  vendorId   String
  sectionId  String?
  seatRow    String?
  seatNumber String?
  status     OrderStatus @default(PENDING_PAYMENT)
  totalCents Int
  currency   String
  note       String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  stadium Stadium     @relation(fields: [stadiumId], references: [id])
  vendor  Vendor      @relation(fields: [vendorId], references: [id])
  section Section?    @relation(fields: [sectionId], references: [id])
  items   OrderItem[]

  @@index([stadiumId, status, createdAt])
  @@index([vendorId, status])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  /// Snapshot at time of order so history survives menu edits.
  name      String
  unitCents Int
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}
