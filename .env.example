# PostgreSQL connection string (Neon pooled URL with sslmode=require in production).
# Local Postgres:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stadium?schema=public"
# Or, with no Postgres installed, run `npx prisma dev` and paste the URL it prints.

# Public origin, used for absolute URLs (QR codes, manifest, OG). No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe. The publishable key is sent to the browser. The secret and webhook secret stay on the server.
STRIPE_PUB_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Sentry. The DSN is public and is sent to the browser. The auth token stays on the build machine and uploads source maps.
# NEXT_PUBLIC_SENTRY_DEV=1 sends errors while running `next dev`. Leave it unset and local errors stay off Sentry.
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DEV=""
SENTRY_ORG="inseat"
SENTRY_PROJECT="web"
SENTRY_AUTH_TOKEN=""

# Vercel AI Gateway. Deployments authenticate with OIDC, so this is only needed for local `next dev`.
AI_GATEWAY_API_KEY=""
