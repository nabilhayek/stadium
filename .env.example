# PostgreSQL connection string (Neon pooled URL with sslmode=require in production).
# Local Postgres:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stadium?schema=public"
# Or, with no Postgres installed, run `npx prisma dev` and paste the URL it prints.

# Public origin, used for absolute URLs (QR codes, manifest, OG). No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe. The publishable key is sent to the browser. The secret and webhook secret stay on the server.
# Production webhook endpoint: https://seatize.com/api/stripe/webhook
# (Dashboard → Developers → Webhooks; events: payment_intent.succeeded|processing|payment_failed|canceled, charge.refunded)
STRIPE_PUB_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Vercel Cron Bearer token. Nightly jobs: auto-refund leftover orders, then anonymise old receipts.
# The open orders board also applies the auto-refund wait during service. 0 receipt days turns retention off.
CRON_SECRET=""
RECEIPT_RETENTION_DAYS="365"

# Sentry. The DSN is public and is sent to the browser. The auth token stays on the build machine and uploads source maps.
# NEXT_PUBLIC_SENTRY_DEV=1 sends errors while running `next dev`. Leave it unset and local errors stay off Sentry.
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DEV=""
SENTRY_ORG="inseat"
SENTRY_PROJECT="web"
SENTRY_AUTH_TOKEN=""

# Vercel AI Gateway. Deployments authenticate with OIDC, so this is only needed for local `next dev`.
AI_GATEWAY_API_KEY=""

# Resend. Mail is sent from the verified seatize.com domain. Leave the key empty and nothing is sent.
RESEND_API_KEY=""
# EMAIL_FROM="Seat Service <orders@seatize.com>"

# Web Push (order alerts on phones, new-order alerts on the desk). Generate a pair with `npx web-push generate-vapid-keys`.
# The public key is sent to the browser. The private key stays on the server. Leave both empty and nothing is sent.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
